      "id": "hypertension", "clinicalKind": "DISEASE", "categoryIds": ["circulatory"], "course": "CHRONIC", "careDepartmentIds": ["cardiology", "general_medicine"], "sourceIds": ["who_icd11_2025"],
      "i18n": { "zh": { "label": "高血压", "aliases": ["原发性高血压"], "description": "以体循环动脉血压持续升高为特征的慢性心血管疾病。诊断、危险分层和药物调整应由医疗专业人员结合规范血压测量及靶器官风险评估完成。" }, "en": { "label": "Hypertension", "aliases": ["Essential hypertension"], "description": "A chronic cardiovascular condition characterized by persistently elevated systemic arterial blood pressure. Diagnosis, risk stratification, and treatment adjustment require standardized measurements and clinical assessment." } },
      "icd11References": [{ "release": "2025-01", "chapterCode": "11", "chapterTitle": { "zh": "循环系统疾病", "en": "Diseases of the circulatory system" }, "blockCode": "BA00-BA04", "code": "BA00", "title": { "zh": "原发性高血压", "en": "Essential hypertension" } }],
      "nutrientRecommendations": [{ "nutrientId": "sodium", "recommendation": "STRICT_LIMIT" }, { "nutrientId": "potassium", "recommendation": "INCREASE" }, { "nutrientId": "dietary_fiber", "recommendation": "INCREASE" }, { "nutrientId": "saturated_fat", "recommendation": "LIMIT" }]
    },
    {
      "id": "type2_diabetes", "clinicalKind": "DISEASE", "categoryIds": ["endocrine_metabolic"], "course": "CHRONIC", "careDepartmentIds": ["endocrinology", "general_medicine", "nutrition"], "sourceIds": ["who_icd11_2025"],
      "i18n": { "zh": { "label": "2型糖尿病", "aliases": ["2型DM"], "description": "以胰岛素抵抗和胰岛素分泌相对不足导致的慢性高血糖为主要特征。需要长期监测血糖及并发症风险，并在医生和营养专业人员指导下进行生活方式和药物管理。" }, "en": { "label": "Type 2 Diabetes", "aliases": ["Type 2 diabetes mellitus", "T2DM"], "description": "A chronic hyperglycemic disorder mainly characterized by insulin resistance and relative insulin secretory deficiency. Long-term glucose and complication-risk monitoring, lifestyle care, and medicines require professional guidance." } },
      "icd11References": [{ "release": "2025-01", "chapterCode": "05", "chapterTitle": { "zh": "内分泌、营养或代谢疾病", "en": "Endocrine, nutritional or metabolic diseases" }, "blockCode": "5A10-5A1Z", "code": "5A11", "title": { "zh": "2型糖尿病", "en": "Type 2 diabetes mellitus" } }],
      "nutrientRecommendations": [{ "nutrientId": "carbohydrate", "recommendation": "LIMIT" }, { "nutrientId": "sugar", "recommendation": "STRICT_LIMIT" }, { "nutrientId": "dietary_fiber", "recommendation": "INCREASE" }]
    },
    {
      "id": "dyslipidemia", "clinicalKind": "RISK_STATE", "categoryIds": ["endocrine_metabolic", "circulatory"], "course": "CHRONIC", "careDepartmentIds": ["endocrinology", "cardiology"], "sourceIds": ["who_icd11_2025"],
      "i18n": { "zh": { "label": "血脂异常", "aliases": ["高脂血症"], "description": "指血浆脂质或脂蛋白水平异常，包括胆固醇、甘油三酯升高或高密度脂蛋白胆固醇降低等表型。应结合整体动脉粥样硬化性心血管风险决定干预方案。" }, "en": { "label": "Dyslipidemia", "aliases": ["Hyperlipidemia"], "description": "Abnormal plasma lipid or lipoprotein levels, including elevated cholesterol or triglycerides and low HDL cholesterol. Management should be based on overall atherosclerotic cardiovascular risk." } },
      "icd11References": [{ "release": "2025-01", "chapterCode": "05", "chapterTitle": { "zh": "内分泌、营养或代谢疾病", "en": "Endocrine, nutritional or metabolic diseases" }, "blockCode": "5C80-5C8Z", "code": "5C80", "title": { "zh": "脂蛋白代谢障碍", "en": "Disorders of lipoprotein metabolism" } }],
      "nutrientRecommendations": [{ "nutrientId": "saturated_fat", "recommendation": "STRICT_LIMIT" }, { "nutrientId": "cholesterol", "recommendation": "LIMIT" }, { "nutrientId": "dietary_fiber", "recommendation": "INCREASE" }]
    },
    {
      "id": "pcos", "clinicalKind": "SYNDROME", "categoryIds": ["sexual_health", "endocrine_metabolic"], "applicability": { "requiredAnatomicalTraits": ["OVARIES"] }, "course": "CHRONIC", "careDepartmentIds": ["gynecology", "endocrinology", "reproductive_medicine"], "sourceIds": ["who_icd11_2025"],
      "i18n": { "zh": { "label": "多囊卵巢综合征", "aliases": ["PCOS"], "description": "育龄女性常见的内分泌与代谢综合征，可表现为排卵障碍、高雄激素表现和多囊卵巢形态。诊断需排除其他病因，并由妇科或内分泌专科综合评估。" }, "en": { "label": "Polycystic Ovary Syndrome", "aliases": ["PCOS"], "description": "A common endocrine-metabolic syndrome in reproductive-age women that may involve ovulatory dysfunction, hyperandrogenism, and polycystic ovarian morphology. Diagnosis requires exclusion of alternative causes and specialist assessment." } },
      "icd11References": [{ "release": "2025-01", "chapterCode": "17", "chapterTitle": { "zh": "性健康相关状况", "en": "Conditions related to sexual health" }, "blockCode": "GA34", "code": "GA34.2", "title": { "zh": "多囊卵巢综合征", "en": "Polycystic ovarian syndrome" } }],
      "nutrientRecommendations": [{ "nutrientId": "carbohydrate", "recommendation": "LIMIT" }, { "nutrientId": "sugar", "recommendation": "STRICT_LIMIT" }, { "nutrientId": "saturated_fat", "recommendation": "LIMIT" }, { "nutrientId": "dietary_fiber", "recommendation": "INCREASE" }]
    },
    {
      "id": "fatty_liver", "clinicalKind": "DISEASE", "categoryIds": ["digestive", "endocrine_metabolic"], "course": "CHRONIC", "careDepartmentIds": ["hepatology", "gastroenterology", "endocrinology"], "sourceIds": ["who_icd11_2025"],
      "i18n": { "zh": { "label": "代谢功能障碍相关脂肪性肝病", "aliases": ["脂肪肝", "MASLD", "非酒精性脂肪性肝病"], "description": "指肝细胞脂肪变并伴代谢风险因素的脂肪性肝病。酒精相关及其他病因的脂肪性肝病应另行诊断和编码。" }, "en": { "label": "Metabolic Dysfunction-Associated Steatotic Liver Disease", "aliases": ["MASLD", "Fatty liver", "Nonalcoholic fatty liver disease"], "description": "Steatotic liver disease with hepatic steatosis and metabolic risk factors. Alcohol-related and other causes of steatotic liver disease require separate diagnosis and coding." } },
      "icd11References": [{ "release": "2025-01", "chapterCode": "13", "chapterTitle": { "zh": "消化系统疾病", "en": "Diseases of the digestive system" }, "blockCode": "DB92", "code": "DB92.0", "title": { "zh": "非酒精性脂肪性肝病", "en": "Nonalcoholic fatty liver disease" }, "mappingType": "BROADER_TERM" }],
      "nutrientRecommendations": [{ "nutrientId": "energy", "recommendation": "LIMIT" }, { "nutrientId": "saturated_fat", "recommendation": "STRICT_LIMIT" }, { "nutrientId": "sugar", "recommendation": "LIMIT" }, { "nutrientId": "dietary_fiber", "recommendation": "INCREASE" }]
    },
    {
      "id": "coronary_heart_disease", "clinicalKind": "DISEASE", "categoryIds": ["circulatory"], "course": "CHRONIC", "careDepartmentIds": ["cardiology", "cardiothoracic_surgery"], "sourceIds": ["who_icd11_2025"],
      "i18n": { "zh": { "label": "冠状动脉粥样硬化性心脏病", "aliases": ["冠心病", "CHD"], "description": "通常由冠状动脉粥样硬化导致心肌供血不足。胸痛、呼吸困难或疑似急性冠脉综合征时应立即急诊评估，不能仅依靠饮食建议处理。" }, "en": { "label": "Coronary Heart Disease", "aliases": ["CHD", "Chronic ischaemic heart disease"], "description": "Commonly results from coronary atherosclerosis and inadequate myocardial blood supply. Chest pain, breathlessness, or suspected acute coronary syndrome requires immediate emergency assessment, not dietary advice alone." } },
      "icd11References": [{ "release": "2025-01", "chapterCode": "11", "chapterTitle": { "zh": "循环系统疾病", "en": "Diseases of the circulatory system" }, "blockCode": "BA80-BA8Z", "code": "BA80", "title": { "zh": "慢性缺血性心脏病", "en": "Chronic ischaemic heart disease" } }],
      "nutrientRecommendations": [{ "nutrientId": "saturated_fat", "recommendation": "FORBID" }, { "nutrientId": "cholesterol", "recommendation": "STRICT_LIMIT" }, { "nutrientId": "sodium", "recommendation": "LIMIT" }, { "nutrientId": "dietary_fiber", "recommendation": "INCREASE" }, { "nutrientId": "potassium", "recommendation": "INCREASE" }]
    },
    {
      "id": "chronic_kidney_disease", "clinicalKind": "DISEASE", "categoryIds": ["genitourinary"], "course": "CHRONIC", "careDepartmentIds": ["nephrology", "urology"], "sourceIds": ["who_icd11_2025"],
      "i18n": { "zh": { "label": "慢性肾病", "aliases": ["CKD"], "description": "指肾脏结构或功能异常持续至少三个月并影响健康的状态。分期、蛋白质和电解质限制须根据估算肾小球滤过率、尿蛋白和合并症由肾内科个体化制定。" }, "en": { "label": "Chronic Kidney Disease", "aliases": ["CKD"], "description": "A condition of kidney structure or function abnormality persisting for at least three months with health implications. Staging and protein or electrolyte restrictions must be individualized by nephrology using eGFR, albuminuria, and comorbidity data." } },
      "icd11References": [{ "release": "2025-01", "chapterCode": "16", "chapterTitle": { "zh": "泌尿生殖系统疾病", "en": "Diseases of the genitourinary system" }, "blockCode": "GB60-GB61", "code": "GB60", "title": { "zh": "慢性肾病", "en": "Chronic kidney disease" } }],
      "nutrientRecommendations": [{ "nutrientId": "sodium", "recommendation": "STRICT_LIMIT" }, { "nutrientId": "potassium", "recommendation": "LIMIT" }, { "nutrientId": "protein", "recommendation": "LIMIT" }]
    },
    {
      "id": "osa", "clinicalKind": "DISEASE", "categoryIds": ["sleep"], "course": "CHRONIC", "careDepartmentIds": ["sleep_medicine", "respiratory_medicine", "otolaryngology"], "sourceIds": ["who_icd11_2025"],
      "i18n": { "zh": { "label": "阻塞性睡眠呼吸暂停", "aliases": ["OSA", "阻塞性睡眠呼吸暂停低通气综合征"], "description": "睡眠中反复发生上气道塌陷，导致呼吸暂停或低通气、间歇性低氧和睡眠片段化。确诊通常依赖睡眠监测。" }, "en": { "label": "Obstructive Sleep Apnoea", "aliases": ["OSA"], "description": "Recurrent upper-airway collapse during sleep causes apnoea or hypopnoea, intermittent hypoxaemia, and sleep fragmentation. Diagnosis usually requires sleep testing." } },
      "icd11References": [{ "release": "2025-01", "chapterCode": "07", "chapterTitle": { "zh": "睡眠觉醒障碍", "en": "Sleep-wake disorders" }, "blockCode": "7A40", "code": "7A40.0", "title": { "zh": "阻塞性睡眠呼吸暂停", "en": "Obstructive sleep apnoea" } }],
      "nutrientRecommendations": [{ "nutrientId": "energy", "recommendation": "LIMIT" }, { "nutrientId": "saturated_fat", "recommendation": "LIMIT" }, { "nutrientId": "sugar", "recommendation": "LIMIT" }]
    },
    {
      "id": "osteoarthritis", "clinicalKind": "DISEASE", "categoryIds": ["musculoskeletal"], "course": "CHRONIC", "careDepartmentIds": ["orthopedics", "rheumatology", "rehabilitation"], "sourceIds": ["who_icd11_2025"],
      "i18n": { "zh": { "label": "骨关节炎", "aliases": ["OA"], "description": "以关节软骨退变、骨重塑和疼痛功能受限为主要表现的慢性关节疾病，常累及膝、髋、手等关节。" }, "en": { "label": "Osteoarthritis", "aliases": ["OA"], "description": "A chronic joint disease marked by cartilage degeneration, bone remodeling, pain, and functional limitation, often affecting the knee, hip, or hand." } },
      "icd11References": [{ "release": "2025-01", "chapterCode": "15", "chapterTitle": { "zh": "肌肉骨骼系统或结缔组织疾病", "en": "Diseases of the musculoskeletal system or connective tissue" }, "blockCode": "FA00-FA0Z", "code": "FA00", "title": { "zh": "骨关节炎", "en": "Osteoarthritis" } }],
      "nutrientRecommendations": [{ "nutrientId": "calcium", "recommendation": "INCREASE" }, { "nutrientId": "energy", "recommendation": "LIMIT" }]
    },
    {
      "id": "hyperuricemia", "clinicalKind": "LABORATORY_ABNORMALITY", "categoryIds": ["endocrine_metabolic"], "course": "CHRONIC", "careDepartmentIds": ["rheumatology", "nephrology", "endocrinology"], "sourceIds": ["who_icd11_2025"],
      "i18n": { "zh": { "label": "高尿酸血症", "aliases": ["高尿酸"], "description": "指血尿酸水平升高，是痛风和尿酸性肾结石的风险因素，但并非所有患者都会发生痛风。" }, "en": { "label": "Hyperuricaemia", "aliases": ["Hyperuricemia"], "description": "Elevated serum urate is a risk factor for gout and uric-acid stones, but not every person develops gout." } },
      "icd11References": [{ "release": "2025-01", "chapterCode": "05", "chapterTitle": { "zh": "内分泌、营养或代谢疾病", "en": "Endocrine, nutritional or metabolic diseases" }, "blockCode": "5C56", "code": "5C56.0", "title": { "zh": "高尿酸血症", "en": "Hyperuricaemia" } }],
      "nutrientRecommendations": [{ "nutrientId": "protein", "recommendation": "LIMIT" }, { "nutrientId": "energy", "recommendation": "LIMIT" }, { "nutrientId": "sugar", "recommendation": "LIMIT" }]
    },
    {
      "id": "hypothyroidism", "clinicalKind": "DISEASE", "categoryIds": ["endocrine_metabolic"], "course": "CHRONIC", "careDepartmentIds": ["endocrinology", "general_medicine"], "sourceIds": ["who_icd11_2025"],
      "i18n": { "zh": { "label": "甲状腺功能减退症", "aliases": ["甲减"], "description": "甲状腺激素分泌不足导致的内分泌疾病，可出现乏力、怕冷、体重变化等非特异症状。" }, "en": { "label": "Hypothyroidism", "aliases": ["Underactive thyroid"], "description": "An endocrine disorder caused by insufficient thyroid-hormone production and potentially associated with nonspecific symptoms such as fatigue, cold intolerance, and weight change." } },
      "icd11References": [{ "release": "2025-01", "chapterCode": "05", "chapterTitle": { "zh": "内分泌、营养或代谢疾病", "en": "Endocrine, nutritional or metabolic diseases" }, "blockCode": "5A00-5A0Z", "code": "5A00", "title": { "zh": "甲状腺功能减退症", "en": "Hypothyroidism" } }],
      "nutrientRecommendations": [{ "nutrientId": "dietary_fiber", "recommendation": "FREE" }, { "nutrientId": "calcium", "recommendation": "INCREASE" }, { "nutrientId": "iron", "recommendation": "INCREASE" }]
    },
    {
      "id": "migraine", "clinicalKind": "DISEASE", "categoryIds": ["nervous_system"], "course": "EPISODIC", "careDepartmentIds": ["neurology", "headache_clinic"], "sourceIds": ["who_icd11_2025"],
      "i18n": { "zh": { "label": "偏头痛", "aliases": [], "description": "常表现为反复发作的中重度头痛，可伴恶心、畏光、畏声或先兆。首次或突发的剧烈头痛、神经功能异常等危险信号需要及时急诊评估。" }, "en": { "label": "Migraine", "aliases": [], "description": "A recurrent moderate-to-severe headache disorder that may include nausea, photophobia, phonophobia, or aura. A first or sudden severe headache or focal neurological symptoms warrants urgent assessment." } },
      "icd11References": [{ "release": "2025-01", "chapterCode": "08", "chapterTitle": { "zh": "神经系统疾病", "en": "Diseases of the nervous system" }, "blockCode": "8A80-8A8Z", "code": "8A80", "title": { "zh": "偏头痛", "en": "Migraine" } }],
      "nutrientRecommendations": [{ "nutrientId": "sodium", "recommendation": "FREE" }, { "nutrientId": "saturated_fat", "recommendation": "FREE" }]
    }
  ]
