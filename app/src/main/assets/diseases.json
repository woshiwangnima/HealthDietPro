    {
      "id": "hypertension",
      "clinicalKind": "DISEASE",
      "categoryIds": [
        "circulatory"
      ],
      "course": "CHRONIC",
      "careDepartmentIds": [
        "cardiology",
        "general_medicine"
      ],
      "sourceIds": [
        "who_icd11_2025"
      ],
      "i18n": {
        "zh": {
          "label": "高血压",
          "aliases": [
            "原发性高血压"
          ],
          "description": "以体循环动脉血压持续升高为特征的慢性心血管疾病。诊断、危险分层和药物调整应由医疗专业人员结合规范血压测量及靶器官风险评估完成。"
        },
        "en": {
          "label": "Hypertension",
          "aliases": [
            "Essential hypertension"
          ],
          "description": "A chronic cardiovascular condition characterized by persistently elevated systemic arterial blood pressure. Diagnosis, risk stratification, and treatment adjustment require standardized measurements and clinical assessment."
        }
      },
      "icd11References": [
        {
          "release": "2025-01",
          "chapterCode": "11",
          "chapterTitle": {
            "zh": "循环系统疾病",
            "en": "Diseases of the circulatory system"
          },
          "blockCode": "BA00-BA04",
          "code": "BA00",
          "title": {
            "zh": "原发性高血压",
            "en": "Essential hypertension"
          }
        }
      ],
      "nutrientRecommendations": [
        {
          "nutrientId": "sodium",
          "recommendation": "STRICT_LIMIT"
        },
        {
          "nutrientId": "potassium",
          "recommendation": "INCREASE"
