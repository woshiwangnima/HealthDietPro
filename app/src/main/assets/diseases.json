        "who_icd11_2025"
      ],
      "i18n": {
        "zh": {
          "label": "2型糖尿病",
          "aliases": [
            "2型DM"
          ],
          "description": "以胰岛素抵抗和胰岛素分泌相对不足导致的慢性高血糖为主要特征。需要长期监测血糖及并发症风险，并在医生和营养专业人员指导下进行生活方式和药物管理。"
        },
        "en": {
          "label": "Type 2 Diabetes",
          "aliases": [
            "Type 2 diabetes mellitus",
            "T2DM"
          ],
          "description": "A chronic hyperglycemic disorder mainly characterized by insulin resistance and relative insulin secretory deficiency. Long-term glucose and complication-risk monitoring, lifestyle care, and medicines require professional guidance."
        }
      },
      "icd11References": [
        {
          "release": "2025-01",
