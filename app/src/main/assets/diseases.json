        {
          "nutrientId": "dietary_fiber",
          "recommendation": "INCREASE"
        },
        {
          "nutrientId": "saturated_fat",
          "recommendation": "LIMIT"
        }
      ]
    },
    {
      "id": "type1_diabetes",
      "clinicalKind": "DISEASE",
      "categoryIds": [
        "endocrine_metabolic"
      ],
      "course": "CHRONIC",
      "careDepartmentIds": [
        "endocrinology",
        "general_medicine",
        "nutrition"
      ],
      "sourceIds": [
        "who_icd11_2025"
      ],
      "i18n": {
        "zh": {
          "label": "1型糖尿病",
          "aliases": [
            "1型DM",
            "胰岛素依赖型糖尿病"
          ],
          "description": "因自身免疫破坏胰岛β细胞导致胰岛素绝对缺乏的慢性高血糖状态。需终身依赖外源性胰岛素治疗，并需在专业指导下进行血糖监测、营养管理和并发症筛查。"
        },
        "en": {
          "label": "Type 1 Diabetes Mellitus",
          "aliases": [
            "T1DM",
            "Insulin-dependent diabetes"
          ],
          "description": "A chronic hyperglycaemic state resulting from autoimmune destruction of pancreatic beta cells, leading to absolute insulin deficiency. Requires lifelong exogenous insulin therapy, with professional guidance on glucose monitoring, nutritional management, and complication screening."
        }
      },
      "icd11References": [
        {
          "release": "2025-01",
          "chapterCode": "05",
          "chapterTitle": {
            "zh": "内分泌、营养或代谢疾病",
            "en": "Endocrine, nutritional or metabolic diseases"
          },
          "blockCode": "5A10-5A1Z",
          "code": "5A10",
          "title": {
            "zh": "1型糖尿病",
            "en": "Type 1 diabetes mellitus"
          }
        }
      ],
      "nutrientRecommendations": [
        {
          "nutrientId": "carbohydrate",
          "recommendation": "LIMIT"
        },
        {
          "nutrientId": "sugar",
          "recommendation": "STRICT_LIMIT"
        },
        {
          "nutrientId": "dietary_fiber",
          "recommendation": "INCREASE"
        }
      ]
    },
    {
      "id": "type2_diabetes",
      "clinicalKind": "DISEASE",
      "categoryIds": [
        "endocrine_metabolic"
      ],
      "course": "CHRONIC",
      "careDepartmentIds": [
        "endocrinology",
        "general_medicine",
