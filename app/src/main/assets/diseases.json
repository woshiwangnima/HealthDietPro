      "i18n": {
        "zh": {
          "label": "冠状动脉粥样硬化性心脏病",
          "aliases": [
            "冠心病",
            "CHD"
          ],
          "description": "通常由冠状动脉粥样硬化导致心肌供血不足。胸痛、呼吸困难或疑似急性冠脉综合征时应立即急诊评估，不能仅依靠饮食建议处理。"
        },
        "en": {
          "label": "Coronary Heart Disease",
          "aliases": [
            "CHD",
            "Chronic ischaemic heart disease"
          ],
          "description": "Commonly results from coronary atherosclerosis and inadequate myocardial blood supply. Chest pain, breathlessness, or suspected acute coronary syndrome requires immediate emergency assessment, not dietary advice alone."
        }
      },
