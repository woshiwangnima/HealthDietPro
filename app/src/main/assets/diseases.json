      ],
      "i18n": {
        "zh": {
          "label": "血脂异常",
          "aliases": [
            "高脂血症"
          ],
          "description": "指血浆脂质或脂蛋白水平异常，包括胆固醇、甘油三酯升高或高密度脂蛋白胆固醇降低等表型。应结合整体动脉粥样硬化性心血管风险决定干预方案。"
        },
        "en": {
          "label": "Dyslipidemia",
          "aliases": [
            "Hyperlipidemia"
          ],
          "description": "Abnormal plasma lipid or lipoprotein levels, including elevated cholesterol or triglycerides and low HDL cholesterol. Management should be based on overall atherosclerotic cardiovascular risk."
        }
      },
      "icd11References": [
