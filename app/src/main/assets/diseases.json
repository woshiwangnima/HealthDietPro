      "sourceIds": [
        "who_icd11_2025"
      ],
      "i18n": {
        "zh": {
          "label": "妊娠期糖尿病",
          "aliases": [
            "GDM"
          ],
          "description": "妊娠期间首次发现或发生的糖耐量异常，通常在妊娠中晚期诊断。需通过饮食调整、血糖监测和必要时的胰岛素治疗来管理，以降低母婴并发症风险。"
        },
        "en": {
          "label": "Gestational Diabetes Mellitus",
          "aliases": [
            "GDM"
          ],
          "description": "Glucose intolerance first recognised or occurring during pregnancy, usually diagnosed in the second or third trimester. Management includes dietary adjustment, blood glucose monitoring, and insulin therapy if necessary to reduce maternal and neonatal complications."
        }
      },
      "icd11References": [
        {
          "release": "2025-01",
