    {
      "id": "gestational_diabetes",
      "clinicalKind": "DISEASE",
      "categoryIds": [
        "endocrine_metabolic"
      ],
      "applicability": {
        "requiredPhysiologicalStates": [
          "PREGNANT"
        ]
