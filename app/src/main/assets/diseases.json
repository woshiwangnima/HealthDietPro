      "i18n": {
        "zh": {
          "label": "代谢功能障碍相关脂肪性肝病",
          "aliases": [
            "脂肪肝",
            "MASLD",
            "非酒精性脂肪性肝病"
          ],
          "description": "指肝细胞脂肪变并伴代谢风险因素的脂肪性肝病。酒精相关及其他病因的脂肪性肝病应另行诊断和编码。"
        },
        "en": {
          "label": "Metabolic Dysfunction-Associated Steatotic Liver Disease",
          "aliases": [
            "MASLD",
            "Fatty liver",
            "Nonalcoholic fatty liver disease"
          ],
          "description": "Steatotic liver disease with hepatic steatosis and metabolic risk factors. Alcohol-related and other causes of steatotic liver disease require separate diagnosis and coding."
        }
      },
