      "i18n": {
        "zh": {
          "label": "多囊卵巢综合征",
          "aliases": [
            "PCOS"
          ],
          "description": "育龄女性常见的内分泌与代谢综合征，可表现为排卵障碍、高雄激素表现和多囊卵巢形态。诊断需排除其他病因，并由妇科或内分泌专科综合评估。"
        },
        "en": {
          "label": "Polycystic Ovary Syndrome",
          "aliases": [
            "PCOS"
          ],
          "description": "A common endocrine-metabolic syndrome in reproductive-age women that may involve ovulatory dysfunction, hyperandrogenism, and polycystic ovarian morphology. Diagnosis requires exclusion of alternative causes and specialist assessment."
        }
      },
      "icd11References": [
        {
          "release": "2025-01",
