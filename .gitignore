# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/
app/release/

# Gradle files
.gradle/
gradle-wrapper.properties
!gradle/wrapper/gradle-wrapper.properties

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log
*.tlog

# Android Studio/IntelliJ IDEA
.idea/
*.iml
*.iws
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/runConfigurations.xml
.idea/vcs.xml

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild

# Google Services (e.g. Firebase)
google-services.json

# Crashlytics
com_crashlytics_export_strings.xml

# Fabric
fabric.properties

# Secrets
secrets.properties
.env

# Mac OS X
.DS_Store

# Windows
Thumbs.db

# VS Code
.vscode/

# Opencode
docs/
!docs/
docs/*
!docs/APP_DATA_TABLE_REORDER_DESIGN.md
!docs/SLEEP_RECORD_DESIGN.md
!docs/BLOOD_GLUCOSE_CHART_REFACTOR.md
!docs/FOOD_CATALOG_ASSET_DESIGN.md

# Hidden directories
.*/
!.gitignore

# AGP PDF import workflow: user health reports and derived preview artifacts
tools/agp_pdf/input/*
!tools/agp_pdf/input/.gitkeep
tools/agp_pdf/output/

# Food catalog tooling
# Source JSON, image mappings, original images, and generated runtime catalog
# are intentional project inputs/outputs and must remain trackable.
tools/food_catalog/__pycache__/
tools/food_catalog/images/source/*.json.tmp
tools/food_catalog/images/source/*.tmp
# Developer-only original food images are not required in the repository.
# Keep mapping.json so the generated APK assets remain reproducible when the
# original image set is available locally.
tools/food_catalog/images/source/*.[jJ][pP][gG]
tools/food_catalog/images/source/*.[jJ][pP][eE][gG]
tools/food_catalog/images/source/*.[pP][nN][gG]
tools/food_catalog/images/source/*.[wW][eE][bB][pP]
tools/food_catalog/images/source/*.[bB][mM][pP]
